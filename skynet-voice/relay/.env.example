# Copy to .env and fill in.

# Required
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Server — bind to the Tailscale interface address, never 0.0.0.0.
# Find it with `tailscale ip -4` on SKYNET.
RELAY_HOST=100.85.104.1
RELAY_PORT=8765
RELAY_SHARED_SECRET=choose-a-long-random-string

# Model
RELAY_MODEL=claude-sonnet-4-6

# STT — Wyoming protocol, per Task 0.3. This is the existing
# parakeet-wyoming-bridge service already running on SKYNET.
STT_WYOMING_HOST=127.0.0.1
STT_WYOMING_PORT=10300

# TTS — kokoro (local, default) or azure (cloud fallback — see
# docs/ARCHITECTURE-DECISION.md before choosing this; it means response
# audio leaves the tailnet).
TTS_BACKEND=kokoro

# Kokoro-FastAPI, if TTS_BACKEND=kokoro. Not yet installed on SKYNET as of
# Task 0.3 — see skynet-voice/relay/README.md for setup.
KOKORO_URL=http://127.0.0.1:8880
KOKORO_VOICE=af_bella

# Azure Cognitive Services Neural TTS, if TTS_BACKEND=azure. Reuses the
# credential shape already proven at C:\Users\1981g\.throne\tts-cred.json
# on SKYNET — do not commit real values here.
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus2
AZURE_TTS_VOICE=en-US-AndrewNeural
